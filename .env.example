# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/urban_guardians?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Frontend URL (Update this to your Vercel domain)
CLIENT_URL=https://your-app-name.vercel.app

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# API Keys (Optional)
GOOGLE_MAPS_API_KEY=
SMS_API_KEY=
SMS_SENDER_ID=URBGRD

# Admin Credentials
ADMIN_EMAIL=admin@urbanguardians.com
ADMIN_PASSWORD=Admin@123456

# Vite Frontend Configuration (Update this to your Vercel API domain)
VITE_API_URL=https://your-app-name.vercel.app/api

# Admin signup access code
ADMIN_SIGNUP_CODE=pokemon